{
  "name": "@elevator-sim/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accounts, email confirmation and a leaderboard whose entries are verified by replaying their seed.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "serve": "node dist/main.js"
  },
  "dependencies": {
    "@elevator-sim/core": "*"
  }
}

{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/buildings/*", "/*.json", "/*.md"]
  },

  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript",
    ".md": "text/plain"
  },

  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Cross-Origin-Opener-Policy": "same-origin"
  },

  "routes": [
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/__buildings.json",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/*.json",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}

# A filled-in parameter file carries the owner's repository URL and SSH public key. Neither is a
# secret, and neither belongs in the repository either. `main.parameters.example.json` is the
# committed template.
azure/main.parameters.json

# Compiled ARM output from `az bicep build`. The Bicep is the source; the JSON is a build artefact.
azure/*.json
!azure/main.parameters.example.json
